// ─────────────────────────── Game Banners ───────────────────────────────────
// Admin-managed per-game banner images displayed on listings.
// Games are identified by their slug from GAME_CONFIG (client lib/games.ts).
model gameBanners {
  id          String   @id @default(cuid())
  gameName    String   @unique // matches GAME_CONFIG key, e.g. "Free Fire"
  gameSlug    String   @unique // matches GAME_CONFIG slug, e.g. "free-fire"
  bannerUrl   String   // presigned / public URL stored in B2 "banners" folder
  bannerKey   String?  // B2 storage key for re-signing
  color       String?  // brand color override for the game card gradient
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([gameSlug])
  @@map("game_banners")
}

// ─────────────────────────── Buyer Requests ─────────────────────────────────
// Buyers can post "want-to-buy" requests that sellers can respond to.
enum BuyerRequestStatus {
  OPEN
  CLOSED
  EXPIRED
  FLAGGED        // Contains suspected external contact info — pending manual review
  AUTO_SUSPENDED // Buyer has exceeded 3 verified external contact attempts
}

enum BuyerRequestItemType {
  ACCOUNT
  CURRENCY
  BOOSTING
  ITEM
  OTHER
}

enum DeliveryTimeframe {
  WITHIN_1_HOUR
  WITHIN_24_HOURS
  WITHIN_3_DAYS
  WITHIN_7_DAYS
  FLEXIBLE
}

model buyerRequests {
  id                       String               @id @default(cuid())
  buyerId                  String
  gameName                 String
  gameSlug                 String?
  title                    String               // e.g. "Looking for a Diamond Free Fire account"
  description              String
  itemType                 BuyerRequestItemType @default(ACCOUNT)
  budgetMin                Decimal?             @db.Decimal(12, 2)
  budgetMax                Decimal?             @db.Decimal(12, 2)
  // Legacy single-budget field (kept for backwards compat)
  budget                   Decimal?             @db.Decimal(12, 2)
  currency                 String               @default("NGN")
  region                   String?
  platform                 String?
  rank                     String?
  deliveryTimeframe        DeliveryTimeframe    @default(FLEXIBLE)
  requiredVerificationLevel String?             // "NONE" | "PHONE" | "ID" | "FULLY_VERIFIED"
  status                   BuyerRequestStatus   @default(OPEN)
  // Content moderation
  flagCount                Int                  @default(0)
  isFlagged                Boolean              @default(false)
  flagReason               String?
  flaggedAt                DateTime?
  reviewedByAdminAt        DateTime?
  reviewedByAdminId        String?
  // Auto-suspend tracking — counts verified external contact attempts across ALL requests
  externalContactAttempts  Int                  @default(0)
  expiresAt                DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  buyer        users                  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  offers       buyerRequestOffers[]

  @@index([buyerId])
  @@index([gameName])
  @@index([status])
  @@index([isFlagged])
  @@index([itemType])
  @@index([createdAt])
  @@map("buyer_requests")
}

// Sellers can send offers in response to buyer requests
model buyerRequestOffers {
  id          String   @id @default(cuid())
  requestId   String
  sellerId    String   // sellers.id
  message     String
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("NGN")
  deliveryTime Int?    // minutes
  status      String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | WITHDRAWN
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request     buyerRequests @relation(fields: [requestId], references: [id], onDelete: Cascade)
  seller      sellers       @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([sellerId])
  @@index([status])
  @@map("buyer_request_offers")
}

// ─────────────────────────── Legal Pages (ToS / Privacy) ───────────────────
// Admin-managed legal content pages. One row per page type.
model legalPages {
  id          String   @id @default(cuid())
  pageType    String   @unique // "terms" | "privacy" | "refund" | "cookies"
  title       String
  content     String   // HTML / Markdown body
  version     String   @default("1.0")
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([pageType, isPublished])
  @@map("legal_pages")
}

// ─────────────────────────── Live Chat ──────────────────────────────────────
enum LiveChatStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

model liveChats {
  id           String         @id @default(cuid())
  visitorId    String         // anonymous ID stored in localStorage / cookie
  visitorName  String?
  visitorEmail String?
  status       LiveChatStatus @default(OPEN)
  subject      String?
  assignedTo   String?        // admin user id or 'admin-console'
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages     liveChatMessages[]

  @@index([status])
  @@index([visitorId])
  @@index([createdAt])
  @@map("live_chats")
}

model liveChatMessages {
  id         String   @id @default(cuid())
  chatId     String
  senderType String   // "visitor" | "admin"
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  chat       liveChats @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("live_chat_messages")
}
