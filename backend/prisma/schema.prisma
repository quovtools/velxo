// Creator profile — registered creators get special perks
model creatorProfiles {
  id                    String   @id @default(cuid())
  userId                String   @unique
  handle                String?  // social handle / username
  platform              String?  // youtube, tiktok, instagram, twitter, etc.
  followerCount         Int      @default(0)
  isVerified            Boolean  @default(false)
  verifiedAt            DateTime?
  status                String   @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  rejectionReason       String?
  // Perks
  hasFreePremium        Boolean  @default(false)      // free seller premium access
  premiumGrantedAt      DateTime?
  // Commission override (creators get 20% of Piyrox profit on each referral trade)
  creatorCommissionRate Decimal  @default(0.20) @db.Decimal(5, 4)
  // Signup reward rate (10-50 NGN, increases at tiers)
  signupRewardBase      Decimal  @default(10) @db.Decimal(8, 2)
  // Tier
  tier                  String   @default("STARTER")  // STARTER | RISING | ELITE
  // Tournament slot eligibility
  hasTournamentSlot     Boolean  @default(false)
  bio                   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([isVerified])
  @@map("creator_profiles")
}

