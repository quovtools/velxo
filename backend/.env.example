APP_URL=https://piyrox.shop
API_URL=https://app.piyrox.shop
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Not required for Fly.io deployment — frontend and backend run in the same
# container on the same machine. Next.js proxies all /api/v1/* to localhost:3001
# so requests never cross origins. Only set this if you add an external client.
# CORS_ORIGIN=https://example.com

# ── Database (NeonDB) ─────────────────────────────────────────────────────────
# Use the POOLED connection string for DATABASE_URL (pgBouncer) — this prevents
# waking NeonDB compute on every query and conserves free tier compute hours.
# Append ?sslmode=require&connection_limit=5&pool_timeout=10 to cap connections.
DATABASE_URL=postgresql://neondb_owner:[password]@[pooled-host]-pooler.neon.tech/neondb?sslmode=require&connection_limit=5&pool_timeout=10
# Use the DIRECT (non-pooled) URL for migrations only.
DIRECT_URL=postgresql://neondb_owner:[password]@[direct-host].neon.tech/neondb?sslmode=require

JWT_SECRET=your-production-jwt-secret
JWT_EXPIRES_IN=7d

# ── Cloudinary Storage ────────────────────────────────────────────────────────
# Images are served publicly via Cloudinary CDN — no presigned URLs needed.
# Get these from https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: root folder prefix inside your Cloudinary account (default: piyrox)
CLOUDINARY_FOLDER=piyrox

ADMIN_PASSWORD=your-strong-admin-password-here

# ── Exchange Rates ────────────────────────────────────────────────────────────
# Optional: Get a free key at https://www.exchangerate-api.com (1,500 req/mo free).
# Without a key, the server falls back to the free open.er-api.com endpoint (no key needed).
# With a key, you get higher rate limits and more reliable uptime.
# Rates are cached in-memory for 6 hours — this key is used server-side only, never exposed to clients.
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# ── Payments ──────────────────────────────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=your-flutterwave-encryption-key
FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret
PAYMENT_IO_API_URL=https://api.paymento.io/v1
PAYMENT_IO_API_KEY=your-payment-io-api-key
PAYMENT_IO_SECRET_KEY=your-payment-io-secret-key
PAYMENT_IO_IPN_URL=https://app.piyrox.shop/api/v1/payments/webhook/paymentio

# ── Email ─────────────────────────────────────────────────────────────────────
# Primary: Resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@piyrox.shop
EMAIL_SENDER_NAME=Piyrox
# Fallback: Bavimail (used automatically if Resend fails or hits rate limits)
# BAVIMAIL_API_KEY  — API key from Bavimail dashboard
# BAVIMAIL_ALIAS_ID — sending alias ID for noreply@piyrox.shop (from Bavimail dashboard → Aliases)
BAVIMAIL_API_KEY=your-bavimail-api-key
BAVIMAIL_ALIAS_ID=your-bavimail-alias-id

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.piyrox.shop

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://app.piyrox.shop/api/v1/auth/google/callback
